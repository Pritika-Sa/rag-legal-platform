# LLM Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model (via HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Reranker Model (BAAI/bge-reranker-base via HuggingFace)
RERANKER_MODEL=BAAI/bge-reranker-base

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=legal_platform

# Application Configurations
CHROMA_DB_PATH=vectorstore/chroma_db
UPLOADS_DIR=uploads
REPORTS_DIR=reports

# Optional configurations
PORT=8501
HOST=0.0.0.0

# Authentication - password reset emails (SMTP)
# Leave SMTP_USERNAME empty to disable email sending; reset tokens will
# only be logged to the console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
APP_BASE_URL=http://localhost:8501

# FastAPI adapter (React migration) — signs session JWTs. Additive only;
# nothing above this line is used or modified by the adapter.
JWT_SECRET=change_me_to_a_long_random_value
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:5173

# "View in Tamil" feature — presentation-layer translation only (see
# services/translation_service.py). Runs entirely locally via IndicTrans2
# (AI4Bharat) + CTranslate2 — no API key, no billing, no external service.
# Model weights auto-download from HuggingFace on first use (~200-400MB
# per direction) and are cached locally afterwards; every call after that
# runs fully offline. All of the below are optional and only need setting
# to override the defaults (e.g. to point at your own checkpoint, or to
# force CPU/GPU):
# INDICTRANS2_EN_INDIC_REPO=adalat-ai/ct2-rotary-indictrans2-en-indic-dist-200M
# INDICTRANS2_INDIC_EN_REPO=adalat-ai/ct2-rotary-indictrans2-indic-en-dist-200M
# INDICTRANS2_DEVICE=cpu
# INDICTRANS2_BEAM_SIZE=5
# TRANSLATION_CACHE_DIR=cache/translations
